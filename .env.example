APP_NAME=Statera
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# Hora peninsular. Las fechas de este dominio tienen consecuencias: los plazos de
# notificación de un incidente y la fecha de un documento entregado se cuentan en
# hora local, no en UTC.
APP_TIMEZONE=Europe/Madrid

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_ES

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# PostgreSQL 17, no MySQL ni SQLite: CTEs recursivas para la jerarquía de
# requisitos, JSONB indexable para los atributos ISO 27002 y Row Level Security
# como segunda barrera del aislamiento multi-tenant.
# La aplicación se conecta con `statera_app`, NO con `statera`. PostgreSQL exime
# a los superusuarios de la seguridad a nivel de fila incluso con FORCE, así que
# conectarse como superusuario dejaría la tercera capa del aislamiento puesta y
# sin efecto. `statera` queda como rol administrativo de la base.
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=statera
DB_USERNAME=statera_app
DB_PASSWORD=statera

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@statera.local"
MAIL_FROM_NAME="${APP_NAME}"

# Almacenes S3: evidencias y documentos generados. En desarrollo apuntan a MinIO;
# en producción, a S3 con versionado, cifrado KMS y Object Lock en modo
# compliance (§6 del stack) — en el bucket de documentos, sólo sobre el prefijo
# `emitidas/`, porque un borrador tiene que poder regenerarse.
AWS_ACCESS_KEY_ID=statera
AWS_SECRET_ACCESS_KEY=statera-secret
AWS_DEFAULT_REGION=eu-west-1
AWS_BUCKET=statera-evidencias
AWS_BUCKET_DOCUMENTOS=statera-documentos
AWS_ENDPOINT=http://127.0.0.1:9000
AWS_USE_PATH_STYLE_ENDPOINT=true

# Gotenberg. Versión anclada, nunca alcanzable desde fuera de la red interna.
GOTENBERG_URL=http://127.0.0.1:3000

# Statera vive tras un login: no hay SEO ni primer pintado crítico que
# justifique mantener un proceso de renderizado en servidor. Con el plugin
# @inertiajs/vite, activarlo es cambiar esta variable.
INERTIA_SSR_ENABLED=false

VITE_APP_NAME="${APP_NAME}"

# Segundo factor obligatorio para los roles con permisos de escritura (§ 6 de
# la especificación). Se apaga SÓLO en desarrollo, y apagarlo tiene que ser una
# decisión escrita aquí, nunca un olvido en el código.
EXIGIR_DOS_FACTORES=false
