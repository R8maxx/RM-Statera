# El código entra por bind mount, no por COPY: del contexto de build sólo se
# necesitan los ficheros de docker/. Sin esta lista se envían al demonio más de
# cien megas en cada `--build`.
.git
.idea
node_modules
vendor
public/build
public/hot
storage/app
storage/logs
storage/framework/cache
storage/framework/sessions
storage/framework/testing
storage/framework/views
.env
